# Generated by build.mjs and committed for GitHub Pages. Keep byte-for-byte
# identical to what the build emits, so a rebuild shows a clean diff.
preview.html -text

# The build hashes these files' raw bytes into the module URL in preview.html.
# Let git rewrite their line endings on checkout and a fresh clone on Windows
# would hash differently, so the page would come out dirty on every build.
js/*.js -text
vendor/*.js -text
